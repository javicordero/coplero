---
import { DIRECCION_JUEGO } from "../juego/presentacion"
import Tarjeta from "../juego/Tarjeta.svelte"
import { CODIGO_EJEMPLO, EJEMPLO_TARJETA } from "../landing/ejemploTarjeta"
import Layout from "../layouts/Layout.astro"
import { ACORDES_GADITANOS, PASOS } from "../sitio/contenido"

const URL_SITIO = `https://${DIRECCION_JUEGO}`
const titulo = "Coplero — juego narrativo del Carnaval de Cádiz"
const descripcion =
  "Crea tu personaje, elige modalidad y construye tu carrera en el COAC a base de decisiones. Gratis, sin registro, y acaba en una tarjeta para compartir."
---

<Layout
  title={titulo}
  description={descripcion}
  canonical={`${URL_SITIO}/`}
  og={{
    title: titulo,
    description: descripcion,
    imageUrl: `${URL_SITIO}/api/og/${CODIGO_EJEMPLO}.png`,
    url: `${URL_SITIO}/`,
  }}
>
  <main>
    <section class="hero">
      <h1>Coplero</h1>
      <p class="claim">
        Crea tu personaje, elige modalidad y construye tu carrera en el COAC.
        Cada partida es una historia distinta.
      </p>
      <a class="cta" href="/jugar">Empezar a jugar</a>
      <p class="micro">Gratis y sin registro · unos minutos</p>
    </section>

    <section id="que-es" class="bloque">
      <h2>Qué es Coplero y cómo funciona</h2>
      <p>
        Coplero es un juego narrativo sobre el Carnaval de Cádiz. Eliges
        comparsista o chirigotero, montas tu agrupación y, año tras año, decides
        en verano qué preparar y en febrero cómo jugártela en el concurso.
      </p>
      <p>
        No se trata de ganar: se trata de ver hasta dónde llega tu historia. Al
        final recibes una tarjeta con toda tu carrera lista para compartir.
      </p>
      <ol class="pasos">
        {
          PASOS.map((paso) => (
            <li>
              <span class="numero">{paso.numero}</span>
              <div>
                <h3>{paso.titulo}</h3>
                <p>{paso.texto}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="autor">
        Es el hermano pequeño de <a
          href={ACORDES_GADITANOS}
          target="_blank"
          rel="noopener noreferrer">Acordes Gaditanos</a
        >, la web de acordes del Carnaval de Cádiz. Mismo creador, misma afición.
      </p>
    </section>

    <section id="ejemplo" class="bloque">
      <h2>Tu tarjeta final</h2>
      <p>
        Así termina una carrera: un póster con tu trayectoria, tus premios y los
        momentos que la hicieron tuya.
      </p>
      <div class="ejemplo">
        <Tarjeta tarjeta={EJEMPLO_TARJETA} />
      </div>
      <a class="cta" href="/jugar">Empezar a jugar</a>
    </section>
  </main>
</Layout>

<style>
  main {
    width: 100%;
    max-width: 680px;
    margin: 0 auto;
    padding: 0 1rem 2rem;
  }
  .hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 1rem;
    min-height: 60vh;
    padding: 2rem 0;
  }
  h1 {
    font-size: clamp(2.5rem, 12vw, 4rem);
    line-height: 1;
  }
  h2 {
    font-size: 1.6rem;
    margin-bottom: 1rem;
  }
  h3 {
    font-size: 1.05rem;
  }
  .claim {
    font-size: 1.15rem;
    color: #cdd6e0;
    max-width: 34ch;
  }
  .cta {
    display: inline-block;
    padding: 0.85rem 1.6rem;
    background: #f6ad55;
    color: #1a1206;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
  }
  .cta:hover {
    background: #ffc477;
  }
  .micro {
    font-size: 0.85rem;
    color: #8b98a5;
  }
  .bloque {
    padding: 2rem 0;
    border-top: 1px solid #1d2733;
  }
  p {
    color: #cdd6e0;
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }
  .pasos {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .pasos li {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
  }
  .numero {
    flex: 0 0 2rem;
    height: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #1d2733;
    color: #f6ad55;
    font-weight: 700;
  }
  .autor {
    color: #8b98a5;
    font-size: 0.9rem;
  }
  .autor a {
    color: #f6ad55;
  }
  .ejemplo {
    overflow: hidden;
    border-radius: 12px;
    margin-bottom: 1.25rem;
  }
</style>
