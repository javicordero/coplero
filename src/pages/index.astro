---
import { DIRECCION_JUEGO, urlImagenOg } from "../juego/presentacion"
import Tarjeta from "../juego/Tarjeta.svelte"
import { CODIGO_EJEMPLO, EJEMPLO_TARJETA } from "../landing/ejemploTarjeta"
import Layout from "../layouts/Layout.astro"
import { ACORDES_GADITANOS, DONACION, PASOS } from "../sitio/contenido"

const URL_SITIO = `https://${DIRECCION_JUEGO}`
const titulo = "Coplero — juego narrativo del Carnaval de Cádiz"
const descripcion =
  "Crea tu personaje, elige modalidad y construye tu carrera en el COAC a base de decisiones. Gratis, sin registro, y acaba en una tarjeta para compartir."
---

<Layout
  title={titulo}
  description={descripcion}
  canonical={`${URL_SITIO}/`}
  og={{
    title: titulo,
    description: descripcion,
    imageUrl: urlImagenOg(URL_SITIO, CODIGO_EJEMPLO),
    url: `${URL_SITIO}/`,
  }}
>
  <main>
    <section class="apertura">
      <div class="apertura__contenido">
        <p class="eyebrow">Juego narrativo del Carnaval de Cádiz</p>
        <h1>Coplero</h1>
        <p class="de">
          Del creador de <a
            href={ACORDES_GADITANOS}
            target="_blank"
            rel="noopener noreferrer">Acordes Gaditanos</a
          >
        </p>
        <p class="claim">
          Crea tu personaje, elige modalidad y construye tu historia. Cada
          partida es única.
        </p>
        <a class="cta" href="/jugar">Empezar a jugar</a>
      </div>
    </section>

    <section id="que-es" class="bloque">
      <span class="separador" data-separador aria-hidden="true"></span>
      <h2>Qué es Coplero y cómo funciona</h2>
      <p>
        Coplero es un juego narrativo sobre el Carnaval de Cádiz. Crea tu
        personaje y, año tras año, decides en verano qué preparar y en febrero
        cómo jugártela en el concurso.
      </p>
      <ol class="pasos">
        {
          PASOS.map((paso) => (
            <li>
              <span class="numero">{paso.numero}</span>
              <div>
                <h3>{paso.titulo}</h3>
                <p>{paso.texto}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="ejemplo" class="bloque">
      <span class="separador" data-separador aria-hidden="true"></span>
      <h2>Tu tarjeta final</h2>
      <p>
        Así termina una carrera: una tarjeta que recoge tu trayectoria y
        distinciones.
      </p>
      <div class="marco">
        <Tarjeta tarjeta={EJEMPLO_TARJETA} />
      </div>
      <a class="cta" href="/jugar">Empezar a jugar</a>
      <a
        class="boton-donacion apoyo"
        href={DONACION.url}
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          class="boton-donacion__icono"
          src="/iconos/buy-me-a-coffee.svg"
          alt=""
          width="20"
          height="28"
        />
        <span>{DONACION.etiqueta}</span>
      </a>
    </section>
  </main>
</Layout>

<style>
  /* `main` a todo el ancho: así el hero puede llevar fondo a sangre y el
     contenido de cada bloque se centra en el marco de 680 px. */
  main {
    width: 100%;
    padding: 0 0 var(--esp-6);
  }

  /* Entrada principal: ocupa la primera pantalla (100% menos la cabecera),
     con la escena nocturna a sangre (idea del hero de Claude). */
  .apertura {
    position: relative;
    isolation: isolate;

    display: flex;
    align-items: center;
    justify-content: center;

    min-height: calc(100vh - var(--alto-cabecera, 2.75rem));
    min-height: calc(100svh - var(--alto-cabecera, 2.75rem));

    background:
      radial-gradient(
        circle at 80% 12%,
        color-mix(in srgb, var(--c-invierno-luna) 12%, transparent),
        transparent 26%
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--c-invierno-nube) 60%, var(--c-fondo)) 0%,
        var(--c-invierno-nube) 50%,
        color-mix(in srgb, var(--c-carnaval-violeta) 25%, var(--c-invierno-nube))
          80%,
        var(--c-fondo) 100%
      );
  }

  /* Velo: oscurece por la izquierda (donde va el texto) y funde el borde
     inferior con la página, sin cortes ni «manchas». */
  .apertura::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--c-fondo) 55%, transparent) 0%,
        transparent 65%
      ),
      linear-gradient(180deg, transparent 86%, var(--c-fondo) 100%);
  }

  .apertura__contenido {
    position: relative;
    z-index: 1;

    width: 100%;
    max-width: var(--ancho-marco);
    margin: 0 auto;
    padding: var(--esp-6) var(--esp-4);

    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--esp-4);
  }

  .eyebrow {
    margin: 0 0 calc(-1 * var(--esp-2));
    color: var(--c-acento);
    font-family: var(--fuente-display);
    font-size: var(--texto-sm);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  /* Titular grande como el de Claude, pero acotado al marco y sin romper el
     zoom (el máximo en `rem` no fuerza ancho: `min(22vw, 7rem)`). */
  h1 {
    font-family: var(--fuente-display);
    font-size: min(22vw, 7rem);
    line-height: 0.9;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--c-texto-fuerte);
    text-shadow: 0 2px 18px
      color-mix(in srgb, var(--c-fondo) 70%, transparent);
  }

  h2 {
    font-family: var(--fuente-display);
    font-size: var(--texto-2xl);
    line-height: var(--interlinea-apretada);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--c-texto-fuerte);
    /* Sombra dura, como `.pantalla__cabecera h2` del juego. */
    text-shadow: 2px 2px 0 var(--c-superficie);
    margin-bottom: var(--esp-4);
  }

  h3 {
    font-size: var(--texto-xl);
  }

  .claim {
    font-size: var(--texto-lg);
    color: var(--c-texto);
    max-width: 34ch;
  }

  /* Subtítulo pegado al título. */
  .de {
    margin-top: calc(-1 * var(--esp-3));
    color: color-mix(in srgb, var(--c-texto-suave) 70%, var(--c-fondo));
    font-size: var(--texto-base);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .de a {
    color: var(--c-acento);
    text-decoration: none;
  }

  /* En móviles, el subtítulo cabe en una sola línea. */
  @media (max-width: 429px) {
    .de {
      font-size: var(--texto-sm);
      letter-spacing: 0.1em;
    }
  }

  .cta {
    display: block;
    width: 100%;
    min-height: 3rem;
    padding: var(--esp-3) var(--esp-5);
    background: var(--c-acento);
    color: var(--c-sobre-acento);
    border-radius: var(--radio-pill);
    text-decoration: none;
    font-size: var(--texto-lg);
    font-weight: var(--peso-fuerte);
    letter-spacing: 0.05em;
    text-align: center;
    text-transform: uppercase;
    text-shadow: none;
    transition: background-color var(--dur-1) var(--ease-sal);
  }

  .cta:hover {
    background: var(--c-acento-fuerte);
  }

  /* El botón de donación (FR-016) usa el estilo global `.boton-donacion`;
     aquí solo se ajusta el espacio del bloque. */
  .apoyo {
    margin-top: var(--esp-3);
  }

  /* Cada bloque se centra en el marco; sin cortes ni filetes. */
  .bloque {
    max-width: var(--ancho-marco);
    margin: 0 auto;
    padding: var(--esp-6) var(--esp-4);
  }

  /* Ornamento tipográfico decorativo que sustituye al compás (FR-003). */
  .separador {
    display: block;
    margin-bottom: var(--esp-3);
    color: var(--c-acento);
    font-family: var(--fuente-display);
    font-size: var(--texto-lg);
    letter-spacing: 0.3em;
    line-height: 1;
  }

  .separador::before {
    content: "///";
  }

  p {
    color: var(--c-texto-suave);
    line-height: var(--interlinea-holgada);
    margin-bottom: var(--esp-3);
  }

  /* Bloque principal y descripción del ejemplo: un punto más grandes; los
     subtítulos de los pasos van aparte, más apretados (1.2). */
  .bloque p {
    font-size: var(--texto-lg);
    line-height: var(--interlinea-normal);
  }

  .pasos {
    list-style: none;
    padding: 0;
    margin: var(--esp-5) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--esp-4);
  }

  .pasos li {
    display: flex;
    gap: var(--esp-3);
    align-items: flex-start;
  }

  .pasos li p {
    margin: 0;
    line-height: 1.3;
  }

  .numero {
    flex: 0 0 2rem;
    height: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radio-pill);
    background: var(--c-superficie-alta);
    border: 1px solid var(--c-separador);
    color: var(--c-acento);
    font-weight: var(--peso-fuerte);
  }

  /* El ejemplo realza la tarjeta con el lenguaje del juego. `overflow: hidden`
     contiene el carril de la trayectoria durante el primer render (aún sin
     medir), igual que hacía el antiguo `.ejemplo`. */
  .marco {
    overflow: hidden;
    background: var(--c-superficie);
    border: 1px solid var(--c-separador);
    border-radius: var(--radio-md);
    padding: var(--esp-4);
    box-shadow: var(--sombra-2);
    margin-bottom: var(--esp-5);
  }
</style>
