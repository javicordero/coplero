---
import ReglaCompas from "../components/ReglaCompas.svelte"
import { DIRECCION_JUEGO, urlImagenOg } from "../juego/presentacion"
import Tarjeta from "../juego/Tarjeta.svelte"
import { CODIGO_EJEMPLO, EJEMPLO_TARJETA } from "../landing/ejemploTarjeta"
import Layout from "../layouts/Layout.astro"
import { ACORDES_GADITANOS, PASOS } from "../sitio/contenido"

const URL_SITIO = `https://${DIRECCION_JUEGO}`
const titulo = "Coplero — juego narrativo del Carnaval de Cádiz"
const descripcion =
  "Crea tu personaje, elige modalidad y construye tu carrera en el COAC a base de decisiones. Gratis, sin registro, y acaba en una tarjeta para compartir."
---

<Layout
  title={titulo}
  description={descripcion}
  canonical={`${URL_SITIO}/`}
  og={{
    title: titulo,
    description: descripcion,
    imageUrl: urlImagenOg(URL_SITIO, CODIGO_EJEMPLO),
    url: `${URL_SITIO}/`,
  }}
>
  <main>
    <section class="hero">
      <h1>Coplero</h1>
      <p class="claim">
        Crea tu personaje, elige modalidad y construye tu carrera en el COAC.
        Cada partida es una historia distinta.
      </p>
      <a class="cta" href="/jugar">Empezar a jugar</a>
      <p class="micro">Gratis y sin registro · unos minutos</p>
    </section>

    <section id="que-es" class="bloque">
      <ReglaCompas class="compas-seccion" />
      <h2>Qué es Coplero y cómo funciona</h2>
      <p>
        Coplero es un juego narrativo sobre el Carnaval de Cádiz. Eliges
        comparsista o chirigotero, montas tu agrupación y, año tras año, decides
        en verano qué preparar y en febrero cómo jugártela en el concurso.
      </p>
      <p>
        No se trata de ganar: se trata de ver hasta dónde llega tu historia. Al
        final recibes una tarjeta con toda tu carrera lista para compartir.
      </p>
      <ol class="pasos">
        {
          PASOS.map((paso) => (
            <li>
              <span class="numero">{paso.numero}</span>
              <div>
                <h3>{paso.titulo}</h3>
                <p>{paso.texto}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="autor">
        Es el hermano pequeño de <a
          href={ACORDES_GADITANOS}
          target="_blank"
          rel="noopener noreferrer">Acordes Gaditanos</a
        >, la web de acordes del Carnaval de Cádiz. Mismo creador, misma afición.
      </p>
    </section>

    <section id="ejemplo" class="bloque">
      <ReglaCompas class="compas-seccion" />
      <h2>Tu tarjeta final</h2>
      <p>
        Así termina una carrera: un póster con tu trayectoria, tus premios y los
        momentos que la hicieron tuya.
      </p>
      <div class="ejemplo">
        <Tarjeta tarjeta={EJEMPLO_TARJETA} />
      </div>
      <a class="cta" href="/jugar">Empezar a jugar</a>
    </section>
  </main>
</Layout>

<style>
  main {
    width: 100%;
    max-width: var(--ancho-marco);
    margin: 0 auto;
    padding: 0 var(--esp-4) var(--esp-6);
  }
  .hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: var(--esp-4);
    min-height: 60vh;
    padding: var(--esp-6) 0;
  }
  h1 {
    font-size: var(--texto-3xl);
    line-height: var(--interlinea-apretada);
  }
  h2 {
    font-size: var(--texto-2xl);
    margin-bottom: var(--esp-4);
  }
  h3 {
    font-size: var(--texto-lg);
  }
  .claim {
    font-size: var(--texto-lg);
    color: var(--c-texto-suave);
    max-width: 34ch;
  }
  .cta {
    display: inline-block;
    padding: var(--esp-3) var(--esp-5);
    background: var(--c-acento);
    color: var(--c-sobre-acento);
    border-radius: var(--radio-pill);
    text-decoration: none;
    font-weight: var(--peso-fuerte);
    transition: background-color var(--dur-1) var(--ease-sal);
  }
  .cta:hover {
    background: var(--c-acento-fuerte);
  }
  .micro {
    font-size: var(--texto-sm);
    color: var(--c-texto-suave);
  }
  .bloque {
    padding: var(--esp-6) 0;
    border-top: 1px solid var(--c-separador);
  }
  .compas-seccion {
    max-width: 7rem;
    margin-bottom: var(--esp-4);
  }
  p {
    color: var(--c-texto-suave);
    line-height: var(--interlinea-holgada);
    margin-bottom: var(--esp-3);
  }
  .pasos {
    list-style: none;
    padding: 0;
    margin: var(--esp-2) 0 var(--esp-4);
    display: flex;
    flex-direction: column;
    gap: var(--esp-4);
  }
  .pasos li {
    display: flex;
    gap: var(--esp-3);
    align-items: flex-start;
  }
  .numero {
    flex: 0 0 2rem;
    height: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radio-pill);
    background: var(--c-superficie-alta);
    color: var(--c-acento);
    font-weight: var(--peso-fuerte);
  }
  .autor {
    color: var(--c-texto-suave);
    font-size: var(--texto-sm);
  }
  .autor a {
    color: var(--c-acento);
  }
  .ejemplo {
    overflow: hidden;
    border-radius: var(--radio-md);
    margin-bottom: var(--esp-5);
  }
</style>
