---
import Layout from "../layouts/Layout.astro"
---

<Layout title="Coplero">
  <main>
    <h1>Coplero</h1>
    <p>Juego narrativo de decisiones sobre el Carnaval de Cádiz.</p>
    <a href="/jugar">Jugar</a>
  </main>
</Layout>

<style>
  main {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 2rem;
    text-align: center;
    gap: 1rem;
  }

  h1 {
    font-size: 3rem;
  }

  p {
    color: #888;
  }

  a {
    padding: 0.75rem 1.5rem;
    background: #ededed;
    color: #0a0a0a;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
  }
</style>
