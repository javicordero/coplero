---
import { decodificar } from "../../engine/index"
import { DIRECCION_JUEGO, urlImagenOg } from "../../juego/presentacion"
import Tarjeta from "../../juego/Tarjeta.svelte"
import Layout from "../../layouts/Layout.astro"

export const prerender = false

const { codigo } = Astro.params
const resultado = decodificar(codigo ?? "")
const tarjeta = resultado.ok ? resultado.valor : null

const imagen = urlImagenOg(Astro.url, codigo ?? "")
const titulo = tarjeta
  ? `Carrera de ${tarjeta.nombre ?? "un coplero"}`
  : "Tarjeta no disponible"
const descripcion = tarjeta
  ? (tarjeta.hitos[0]?.texto ?? tarjeta.fraseCierre)
  : "Esta tarjeta no está disponible."
---

<Layout
  title={`${titulo} · Coplero`}
  description={descripcion}
  canonical={tarjeta ? Astro.url.href : undefined}
  noindex={!tarjeta}
  og={{
    title: titulo,
    description: descripcion,
    imageUrl: imagen,
    url: Astro.url.href,
  }}
>
  <main class="resultado">
    {
      tarjeta ? (
        <Tarjeta tarjeta={tarjeta} />
      ) : (
        <section class="aviso" data-testid="codigo-invalido">
          <h1>Esta tarjeta no está disponible</h1>
          <p>
            El enlace puede estar incompleto o ser de una versión anterior. No
            pasa nada: puedes empezar una carrera nueva.
          </p>
          <a href="/jugar">Juega tu carrera en {DIRECCION_JUEGO}</a>
        </section>
      )
    }
  </main>
</Layout>

<style>
  .resultado {
    width: 100%;
    max-width: var(--ancho-bucle);
    margin: 0 auto;
    padding: var(--esp-6) var(--esp-4);
    display: flex;
    flex-direction: column;
    gap: var(--esp-4);
    min-height: calc(100vh - var(--alto-cabecera, 0px));
    min-height: calc(100svh - var(--alto-cabecera, 0px));
    justify-content: center;
  }

  .aviso {
    display: flex;
    flex-direction: column;
    gap: var(--esp-3);
    text-align: center;
  }

  .aviso a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    color: var(--c-acento);
    font-weight: var(--peso-fuerte);
  }
</style>
