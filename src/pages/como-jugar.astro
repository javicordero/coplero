---
import Layout from "../layouts/Layout.astro"
import { FAQ, MODALIDADES_RESUMEN } from "../sitio/contenido"
import { REGLAS } from "../sitio/reglas"
---

<Layout
  title="Cómo jugar · Coplero"
  description="Reglas de Coplero: cómo se avanza por el COAC, las modalidades y las preguntas frecuentes."
>
  <main class="como-jugar">
    <h1>Cómo jugar</h1>

    <section class="bloque">
      <h2>Las reglas</h2>
      {
        REGLAS.map((regla) => (
          <article>
            <h3>{regla.titulo}</h3>
            <p>{regla.texto}</p>
          </article>
        ))
      }
    </section>

    <section class="bloque">
      <h2>Modalidades</h2>
      <div class="rejilla">
        {
          MODALIDADES_RESUMEN.map((modalidad) => (
            <article class="modalidad">
              <h3>{modalidad.nombre}</h3>
              <p>{modalidad.descripcion}</p>
              <p class="foco">{modalidad.enQueDecide}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="bloque">
      <h2>Preguntas frecuentes</h2>
      <div class="faq">
        {
          FAQ.map((entrada) => (
            <details>
              <summary>{entrada.pregunta}</summary>
              <p>{entrada.respuesta}</p>
            </details>
          ))
        }
      </div>
    </section>

    <a class="cta" href="/jugar">Empezar a jugar</a>
  </main>
</Layout>

<style>
  .como-jugar {
    width: 100%;
    max-width: var(--ancho-marco);
    margin: 0 auto;
    padding: var(--esp-6) var(--esp-4);
  }
  h1 {
    margin-bottom: var(--esp-4);
  }
  h2 {
    font-size: var(--texto-2xl);
    margin-bottom: var(--esp-4);
  }
  h3 {
    font-size: var(--texto-lg);
    margin-bottom: var(--esp-1);
  }
  .bloque {
    padding: var(--esp-5) 0;
    border-top: 1px solid var(--c-separador);
  }
  p {
    color: var(--c-texto-suave);
    line-height: var(--interlinea-holgada);
    margin-bottom: var(--esp-3);
  }
  .rejilla {
    display: grid;
    gap: var(--esp-4);
  }
  .modalidad {
    border: 1px solid var(--c-separador);
    border-radius: var(--radio-md);
    padding: var(--esp-4);
    background: var(--c-superficie);
  }
  .foco {
    color: var(--c-acento);
    margin: 0;
    font-size: var(--texto-sm);
  }
  .faq details {
    border-bottom: 1px solid var(--c-separador);
    padding: var(--esp-3) 0;
  }
  .faq summary {
    cursor: pointer;
    font-weight: var(--peso-fuerte);
    color: var(--c-texto);
    display: flex;
    align-items: center;
    gap: var(--esp-2);
    padding: var(--esp-2) 0;
    min-height: 44px;
  }
  .faq summary::before {
    content: "▸";
    color: var(--c-acento);
    transition: transform var(--dur-2) var(--ease-sal);
  }
  .faq details[open] summary::before {
    transform: rotate(90deg);
  }
  .faq summary:hover {
    color: var(--c-acento);
  }
  .faq p {
    margin-top: var(--esp-2);
  }
  .cta {
    display: inline-block;
    margin-top: var(--esp-4);
    padding: var(--esp-3) var(--esp-5);
    background: var(--c-acento);
    color: var(--c-sobre-acento);
    border-radius: var(--radio-pill);
    text-decoration: none;
    font-weight: var(--peso-fuerte);
    transition: background-color var(--dur-1) var(--ease-sal);
  }
  .cta:hover {
    background: var(--c-acento-fuerte);
  }
  @media (min-width: 640px) {
    .rejilla {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
