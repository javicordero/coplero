const REDES_SOCIALES = REDES.filter((r) =>
  ["x", "youtube", "tiktok", "instagram"].includes(r.id),
)
const REDES_AUTOR = REDES.filter((r) => ["linkedin", "github"].includes(r.id))
---

<footer role="contentinfo">
  <div class="wrap brand-social">
    <nav aria-label="Redes sociales">
      <h3>Redes sociales</h3>
      <ul class="iconos">
        {
          REDES_SOCIALES.map((red) => (
            <li>
              <a
                href={red.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={red.nombre}
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={ICONOS[red.id]} />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <address class="wrap">
    <p class="small">Desarrollado por {AUTOR}</p>
    <ul class="iconos">
      {
        REDES_AUTOR.map((red) => (
          <li>
            <a
              href={red.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={red.nombre}
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={ICONOS[red.id]} />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="small">
      El mismo creador de <a
        href={ACORDES_GADITANOS}
        target="_blank"
        rel="noopener noreferrer">Acordes Gaditanos</a
      >.
    </p>
  </address>

  <div class="wrap politics">
    <a href="/colaborar">Colaborar</a>
    <a href="/politicas/politica-de-privacidad">Política de privacidad</a>
    <a href="/politicas/politica-de-cookies">Política de cookies</a>
  </div>

  <div class="wrap bottom">
    <p>© {ANIO} Coplero</p>
    <p class="creditos">
      Tipografías: <a
        href="https://fonts.google.com/specimen/Anton"
        target="_blank"
        rel="noopener noreferrer">Anton</a
      > y <a
        href="https://fonts.google.com/specimen/Atkinson+Hyperlegible"
        target="_blank"
        rel="noopener noreferrer">Atkinson Hyperlegible</a
      >, con licencia OFL.
    </p>
  </div>
</footer>

<style>
  footer {
    background: var(--c-superficie);
    color: var(--c-texto);
    padding: var(--esp-5) 0;
    display: flex;
    flex-direction: column;
    gap: var(--esp-3);
  }
  .wrap {
    width: 100%;
    max-width: var(--ancho-marco);
    margin: 0 auto;
    padding: 0 var(--esp-4);
  }
  h3 {
    font-family: var(--fuente-texto);
    font-size: var(--texto-sm);
    margin: 0 0 var(--esp-2);
  }
  .iconos {
    display: flex;
    gap: var(--esp-3);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .iconos a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    color: var(--c-texto-suave);
    transition: color var(--dur-2) var(--ease-sal),
      transform var(--dur-2) var(--ease-sal);
  }
  .iconos a:hover {
    color: var(--c-acento);
    transform: scale(1.15);
  }
  address {
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: var(--esp-2);
    font-size: var(--texto-sm);
    color: var(--c-texto-suave);
  }
  .small {
    margin: 0;
  }
  .small a {
    color: var(--c-acento);
  }
  .politics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--esp-3);
    font-size: var(--texto-xs);
  }
  .politics a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--c-texto-suave);
    text-decoration: none;
    transition: color var(--dur-2) var(--ease-sal);
  }
  .politics a:hover {
    color: var(--c-acento);
  }
  .bottom p {
    margin: 0;
    font-size: var(--texto-xs);
    color: var(--c-texto-suave);
  }
  .creditos a {
    color: var(--c-texto-suave);
    text-decoration: underline;
  }
  .creditos a:hover {
    color: var(--c-acento);
  }
</style>
