---
// Cabecera del sitio (011). Estática: 0 kB de JS.
// La marca lleva `data-marca`; en /jugar la isla la actualiza según el sexo del personaje.
import ReglaCompas from "./ReglaCompas.svelte"
---

<header class="site-header">
  <div class="wrap">
    <a class="marca" href="/">
      <span data-marca>Coplero</span>
    </a>
    <ReglaCompas class="compas-marca" />
  </div>
</header>

<style>
  .site-header {
    width: 100%;
  }
  .wrap {
    width: 100%;
    max-width: var(--ancho-marco);
    margin: 0 auto;
    padding: var(--esp-4);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--esp-1);
  }
  .marca {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--c-acento);
    font-family: var(--fuente-display);
    font-weight: var(--peso-normal);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .compas-marca {
    max-width: 5rem;
  }
</style>
